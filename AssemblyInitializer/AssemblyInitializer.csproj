<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>ToolBX.$(AssemblyName)</RootNamespace>
		<PackageId>ToolBX.$(AssemblyName)</PackageId>
		<Product>ToolBX.$(AssemblyName)</Product>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>Helps decouple initialization logic by splitting it into AssemblyInitializer classes.</Description>
		<IsAotCompatible>true</IsAotCompatible>
		<IsTrimmable>false</IsTrimmable>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\assemblyinitializer.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
		<PackageReference Include="ToolBX.AutoConfig" Version="4.0.0-beta1" />
		<PackageReference Include="ToolBX.AutoInject" Version="4.0.0-beta.2" />
	</ItemGroup>

	<!-- Build the generator and ship it as an analyzer inside this package. -->
	<ItemGroup>
		<ProjectReference Include="..\AssemblyInitializer.Generators\AssemblyInitializer.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\AssemblyInitializer.Generators\bin\$(Configuration)\netstandard2.0\AssemblyInitializer.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

</Project>

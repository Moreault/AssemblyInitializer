<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="appsettings.json" />
		<Content Include="appsettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AssemblyInitializer.Console\AssemblyInitializer.Console.csproj" />
		<!-- In-solution projects don't receive the generator transitively the way NuGet consumers do, so wire it up explicitly. -->
		<ProjectReference Include="..\AssemblyInitializer.Generators\AssemblyInitializer.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
